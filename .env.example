# Copy this file to .env (git-ignored). docker compose reads it automatically.
# After changing it: docker compose up -d --build

# ---- Database ---------------------------------------------------------------
# MariaDB root password, also used by the app. REQUIRED. The database is only
# reachable from the web container, but still use a strong one in production:
#     openssl rand -hex 24
# The password is set when the database volume is first created. To change it
# later, run ALTER USER inside the db container, or recreate the volume
# (docker compose down -v deletes the data).
DB_PASSWORD=orellapager
#BACKUP_KEEP_DAYS=14     days of nightly backups kept in ./backups

# ---- hCaptcha ---------------------------------------------------------------
# LOCAL TESTING (https://localhost:8443): hCaptcha refuses a real site key on
# localhost, so use its public test keys. The widget always passes with them.
HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
# PRODUCTION (orellapager.me): comment the three lines above, uncomment these,
# and paste the real secret from the hCaptcha dashboard.
#HCAPTCHA_SITEKEY=6a29ba4e-d39b-4e58-b64a-5b47ba5cbad2
#HCAPTCHA_SECRET=ES_your_real_hcaptcha_secret

# ---- Ports ------------------------------------------------------------------
# Local default 8080/8443. Production must be 80/443 so Let's Encrypt renews.
#HTTP_PORT=80
#HTTPS_PORT=443

# ---- Spam / retention -------------------------------------------------------
#BEEP_COOLDOWN=60        seconds an IP must wait between beeps
#RETENTION_DAYS=30       days a non-posting IP is kept before the daily sweep
#APP_DEBUG=0             1 = also show PHP warnings in the browser DevTools console

# ---- Monthly spam report by email -------------------------------------------
# Sent on the 1st of each month. Needs an SMTP relay (the server cannot send
# mail directly). Gmail: create an App Password at myaccount.google.com/apppasswords
REPORT_EMAIL=djorella@ucsc.edu
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@gmail.com
#SMTP_PASS=xxxx xxxx xxxx xxxx
#SMTP_FROM=you@gmail.com
